 "doc_type": "Patient Medication Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        @page {\n            size: A4;\n            margin: 15mm;\n        }\n        \n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: Arial, sans-serif;\n            font-size: 11pt;\n            line-height: 1.4;\n            color: #333;\n        }\n        \n        .prescription-container {\n            width: 100%;\n            max-width: 800px;\n            margin: 0 auto;\n            border: 2px solid #5B4B8A;\n            padding: 20px;\n        }\n        \n        /* Header Section */\n        .header {\n            display: flex;\n            align-items: center;\n            margin-bottom: 20px;\n            padding-bottom: 15px;\n            border-bottom: 2px solid #5B4B8A;\n        }\n        \n        .logo-section {\n            flex: 0 0 150px;\n            margin-right: 20px;\n        }\n        \n        .logo-circle {\n            width: 120px;\n            height: 120px;\n            background: linear-gradient(135deg, #5B4B8A 50%, #87CEEB 50%);\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n        }\n        \n        .logo-text {\n            flex: 1;\n        }\n        \n        .hospital-name-ar {\n            font-size: 32pt;\n            font-weight: bold;\n            color: #5B4B8A;\n            direction: rtl;\n        }\n        \n        .hospital-name-en {\n            font-size: 24pt;\n            font-weight: bold;\n            color: #5B4B8A;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n        }\n        \n        .hospital-subtitle {\n            font-size: 10pt;\n            color: #999;\n            margin-top: 5px;\n        }\n        \n        /* Patient Information Section */\n        .patient-info {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 10px;\n            margin-bottom: 20px;\n            padding: 15px;\n            background-color: #f9f9f9;\n            border: 1px solid #ddd;\n        }\n        \n        .info-row {\n            display: flex;\n            padding: 5px 0;\n        }\n        \n        .info-label {\n            font-weight: bold;\n            min-width: 120px;\n            color: #5B4B8A;\n        }\n        \n        .info-value {\n            flex: 1;\n        }\n        \n        .dispenser-box {\n            grid-column: 2;\n            grid-row: 1 / 4;\n            border: 2px solid #333;\n            padding: 10px;\n            text-align: center;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n        }\n        \n        /* Prescription Symbol */\n        .rx-symbol {\n            width: 60px;\n            height: 60px;\n            border: 3px solid #000;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 32pt;\n            font-weight: bold;\n            margin: 20px 0;\n        }\n        \n        /* Medication Table */\n        .medication-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin: 20px 0;\n        }\n        \n        .medication-table th {\n            background-color: #5B4B8A;\n            color: white;\n            padding: 10px;\n            text-align: left;\n            font-weight: bold;\n            border: 1px solid #333;\n        }\n        \n        .medication-table td {\n            padding: 10px;\n            border: 1px solid #333;\n        }\n        \n        .medication-table tr:nth-child(even) {\n            background-color: #f9f9f9;\n        }\n        \n        .end-prescription {\n            text-align: center;\n            margin: 20px 0;\n            padding: 10px;\n            border-top: 2px dashed #333;\n            border-bottom: 2px dashed #333;\n            font-style: italic;\n        }\n        \n        /* Doctor Information */\n        .doctor-info {\n            margin-top: 30px;\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-end;\n        }\n        \n        .signature-box {\n            flex: 1;\n        }\n        \n        .signature-line {\n            border-bottom: 1px solid #333;\n            min-height: 60px;\n            margin-bottom: 10px;\n        }\n        \n        .doctor-details {\n            border: 2px solid #5B4B8A;\n            padding: 10px;\n            text-align: center;\n            background-color: #f0f0ff;\n        }\n        \n        .doctor-name {\n            font-weight: bold;\n            color: #5B4B8A;\n            font-size: 11pt;\n            margin-bottom: 5px;\n        }\n        \n        .doctor-title {\n            font-size: 9pt;\n            margin-bottom: 3px;\n        }\n        \n        .license-number {\n            font-size: 9pt;\n            font-weight: bold;\n        }\n        \n        .stamp-notice {\n            font-size: 9pt;\n            color: #d9534f;\n            margin-top: 10px;\n        }\n        \n        /* Footer */\n        .footer {\n            margin-top: 20px;\n            padding-top: 15px;\n            border-top: 2px solid #5B4B8A;\n            font-size: 8pt;\n            text-align: center;\n            color: #666;\n            direction: rtl;\n        }\n        \n        .footer-contact {\n            margin-top: 5px;\n            font-size: 8pt;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"prescription-container\">\n        <!-- Header with Logo -->\n        <div class=\"header\">\n            <div class=\"logo-section\">\n                <div class=\"logo-circle\">\n                    <!-- Logo placeholder -->\n                </div>\n            </div>\n            <div class=\"logo-text\">\n                <div class=\"hospital-name-ar\">{{ doc.company or \"\u0633\u064a\u0631\u064a\u0646\" }}</div>\n                <div class=\"hospital-name-en\">{{ doc.company_name_english or \"SERENE\" }}</div>\n                <div class=\"hospital-subtitle\">{{ doc.company_tagline or \"Psychiatry Hospital\" }}</div>\n            </div>\n        </div>\n        \n        <!-- Patient Information -->\n        <div class=\"patient-info\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">File No.</span>\n                <span class=\"info-value\">{{ doc.patient or \"\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">CPR/ID No.</span>\n                <span class=\"info-value\">{{ doc.patient or \"\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">Sex:</span>\n                <span class=\"info-value\">{{ frappe.db.get_value(\"Patient\", doc.patient, \"sex\") if doc.patient else \"\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">Visit No.</span>\n                <span class=\"info-value\">{{ doc.name or \"\" }}</span>\n            </div>\n            \n            <div style=\"grid-column: 1;\">\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Patient Name:</span>\n                    <span class=\"info-value\">{{ doc.patient_name or \"\" }}</span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Nationality:</span>\n                    <span class=\"info-value\">{{ doc.nationality or \"\" }}</span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Age:</span>\n                    <span class=\"info-value\">{{ doc.patient_age or \"\" }}</span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Visit Date:</span>\n                    <span class=\"info-value\">{{ doc.posting_date or doc.creation }}</span>\n                </div>\n            </div>\n            \n            <div class=\"dispenser-box\">\n                <strong>For dispenser</strong>\n                <div style=\"margin-top: 10px;\">No. of<br>Prescns. on<br>Form</div>\n            </div>\n        </div>\n        \n        <!-- Rx Symbol -->\n        <div class=\"rx-symbol\">\u211e</div>\n        \n        <!-- Medication Table -->\n          <!-- MEDICATION TABLE -->\n    <table class=\"medication-table\">\n        <thead>\n        <tr>\n            <th style=\"width:5%\">#</th>\n            <th style=\"width:30%\">Medicine Name</th>\n            <th style=\"width:10%\">Dose</th>\n            <th style=\"width:15%\">Frequency</th>\n            <th style=\"width:10%\">Quantity</th>\n            <th style=\"width:20%\">Notes</th>\n        </tr>\n        </thead>\n\n        <tbody>\n        {% set visible_items = doc.medication_orders | selectattr(\"is_pink\", \"equalto\", 0) | list %}\n\n        {% if visible_items %}\n            {% for item in visible_items %}\n            <tr>\n                <td style=\"text-align:center;\">{{ loop.index }}</td>\n                <td>\n                    <strong>{{ item.drug_name or item.drug }}</strong>\n                    {% if item.dosage_form %} ({{ item.dosage_form }}){% endif %}\n                </td>\n                <td>{{ item.dosage or \"\" }}</td>\n                <td>{{ item.patient_frequency or \"\" }}</td>\n                <td>{{ item.quantity or \"\" }} {{item.uom}}</td>\n                <td>{{ item.instructions or \"\" }}</td>\n            </tr>\n            {% endfor %}\n        {% else %}\n            <tr>\n                <td colspan=\"6\" style=\"text-align:center; font-style:italic;\">\n                    No medications to display\n                </td>\n            </tr>\n        {% endif %}\n        </tbody>\n    </table>\n        \n        <div class=\"end-prescription\">\n            ---------------------------------- End of Prescription ----------------------------------\n        </div>\n        \n        <!-- Doctor Signature Section -->\n        <div class=\"doctor-info\">\n            <div class=\"signature-box\">\n                <div class=\"signature-line\">\n                    <!-- Signature image can be inserted here -->\n                    \n                    <b>Signature</b>\n                </div>\n                <div style=\"text-align: center; font-weight: bold; border-top: 1px solid #333; padding-top: 5px;\">\n                    {{ doc.healthcare_practitioner_name or \"DR. [DOCTOR NAME]\" }}\n                </div>\n                <div class=\"stamp-notice\">Stamp and Signature are Electronically Added</div>\n            </div>\n            \n            <div class=\"doctor-details\">\n                <div class=\"doctor-name\">{{ doc.healthcare_practitioner_name or \"Dr. [Doctor Name]\" }}</div>\n                <div class=\"doctor-title\">{{ frappe.db.get_value(\"Healthcare Practitioner\", doc.practitioner, \"medical_role\") if doc.practitioner else \"Consultant Psychiatrist\" }}</div>\n                <div class=\"license-number\">License No. {{ frappe.db.get_value(\"Healthcare Practitioner\", doc.practitioner, \"licence_no\") if doc.practitioner else \"[License Number]\" }}</div>\n                <div class=\"doctor-title\">{{ doc.company or \"Serene Psychiatry Hospital\" }}</div>\n            </div>\n        </div>\n        \n        <!-- Footer -->\n        <div class=\"footer\">\n            <div style=\"direction: rtl;\">\n                \u0645\u0628\u0646\u0649: {{ doc.building_number or \"17686088\" }} \u0647\u0627\u062a\u0641: {{ doc.phone or \"17686088\" }} \n                \u0641\u0627\u0643\u0633: {{ doc.fax or \"17686088\" }} \u0645\u062a\u0646\u0642\u0644: {{ doc.mobile or \"32177363\" }} \n                \u0637\u0631\u064a\u0642: {{ doc.road or \"4026\" }} \u0645\u062c\u0645\u0639: {{ doc.block or \"340\" }} \u0645\u0628\u0646\u0649 \u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0646: {{ doc.building or \"90518.1\" }}\n            </div>\n           \n            <div class=\"footer-contact\" style=\"direction: ltr;\">\n                Tel: {{ doc.phone or \"17686088\" }} , Fax: {{ doc.fax or \"17686088\" }} , Mobile: {{ doc.mobile or \"32177363\" }} , \n                Bldlng.{{ doc.building_no or \"1301\" }}, Road {{ doc.road_no or \"4526\" }}, 6th Floor, Juffair {{ doc.area_no or \"345\" }}, \n                C.R {{ doc.cr_number or \"90518-1\" }},<br>\n                Kingdom of Bahrain , Email: {{ doc.email or \"serenehospitalbh@gmail.com\" }}\n            </div>\n        </div>\n    </div>\n</body>\n</html>",
